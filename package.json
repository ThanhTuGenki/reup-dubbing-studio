{
  "name": "reup-dubbing-studio",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "lint": "pnpm --filter @reup-dubbing-studio/api lint",
    "typecheck": "pnpm --filter @reup-dubbing-studio/api typecheck",
    "depcruise": "dependency-cruiser --config .dependency-cruiser.cjs apps/api/src apps/web",
    "prepare": "lefthook install"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "dependency-cruiser": "^16.10.4",
    "eslint-plugin-boundaries": "^5.4.0",
    "lefthook": "^1.13.6",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6"
  }
}
