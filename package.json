{
  "name": "reup-dubbing-studio",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.28.0 <11"
  },
  "scripts": {
    "lint": "eslint . && pnpm --recursive --if-present lint",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "test:e2e": "pnpm --recursive --if-present test:e2e",
    "depcruise": "depcruise --config .dependency-cruiser.cjs apps/api/src apps/web/src",
    "contract:lint": "redocly lint --config contracts/openapi/.redocly.yaml contracts/openapi/web.openapi.yaml contracts/openapi/worker.openapi.yaml",
    "contract:generate": "pnpm --filter @reup-dubbing-studio/api-contract generate",
    "contract:check": "pnpm contract:lint && pnpm contract:generate && git diff --exit-code -- packages/api-contract/src/generated packages/api-contract/src/generated-worker",
    "test:contract": "pnpm --filter @reup-dubbing-studio/api-contract test && pnpm --filter @reup-dubbing-studio/api-client test",
    "contract:verify": "pnpm contract:check && pnpm test:contract",
    "web:dev": "pnpm --filter @reup-dubbing-studio/web dev",
    "web:build": "pnpm --filter @reup-dubbing-studio/web build",
    "web:test": "pnpm --filter @reup-dubbing-studio/web test",
    "web:test:e2e": "pnpm --filter @reup-dubbing-studio/web test:e2e"
  },
  "devDependencies": {
    "@redocly/cli": "^2.53.2",
    "@reup-dubbing-studio/eslint-config": "workspace:*",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.1"
  }
}
