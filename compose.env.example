# Environment for `docker compose` (compose.yaml). Copy to `.env` at the repository
# root (`cp compose.env.example .env`); never commit `.env`.

# MagicDNS name of this machine on the tailnet, without scheme,
# e.g. my-mac.tail1234.ts.net (`tailscale status --json | jq -r '.Self.DNSName | rtrimstr(".")'`).
# Baked into the Web image at build time: rebuild `web` after changing it.
PUBLIC_HOST=

POSTGRES_PASSWORD=
# POSTGRES_USER=reup
# POSTGRES_DB=reup_dubbing_studio

# 32 random bytes, base64: `openssl rand -base64 32`.
# Encrypts credentials stored via Settings; changing it makes them unreadable.
SETTINGS_ENCRYPTION_KEY=

# Content Agent through an OpenAI/Anthropic-compatible proxy instead of the official APIs,
# e.g. CLI Proxy API on this machine. The proxy's own API key goes in Settings.
# CONTENT_AGENT_ANTHROPIC_BASE_URL=http://host.docker.internal:8317
# CONTENT_AGENT_OPENAI_BASE_URL=http://host.docker.internal:8317

# WEB_PORT=8080
# LOG_LEVEL=info
# RATE_LIMIT_MAX=600
# RATE_LIMIT_WINDOW_MS=60000
# HEALTH_RATE_LIMIT_MAX=120
