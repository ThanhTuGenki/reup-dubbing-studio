REUP_WORKER_CONTROL_PLANE_URL=http://localhost:3000/worker/v1
REUP_WORKER_ROLE=BATCH_MEDIA
REUP_WORKER_IMAGE_DIGEST=sha256:replace-with-approved-image-digest
REUP_WORKER_AGENT_VERSION=0.1.0
REUP_WORKER_CONTRACT_VERSION=1
REUP_WORKER_CAPABILITIES=media.render.ffmpeg.v1
REUP_WORKER_CREDENTIAL_FILE=.state/credential
REUP_WORKER_WORKSPACE_ROOT=.work
REUP_WORKER_ENROLLMENT_TOKEN=
REUP_WORKER_EXECUTOR=fake
# Batch image: batch. Keep media.desub.v1 out of capabilities while hard-sub removal is disabled.
REUP_WORKER_FAKE_BEHAVIOR=success
REUP_WORKER_FAKE_STEP_DELAY_SECONDS=0.01
REUP_WORKER_MAX_INPUT_BYTES=10737418240
REUP_WORKER_ALLOW_HTTP_ASSET_URLS=false
REUP_WORKER_SUCCESS_WORKSPACE_RETENTION_SECONDS=0
REUP_WORKER_FAILURE_WORKSPACE_RETENTION_SECONDS=3600
# Interactive TTS image: set executor=interactive-tts and role=INTERACTIVE_TTS.
# Official pretrained weights are CC-BY-NC and are blocked in production-commercial mode.
REUP_WORKER_TTS_MODEL_ID=k2-fsa/OmniVoice
REUP_WORKER_TTS_MODEL_REVISION=c5fdb5ccb189668d56333f77ba2629f4cd7535f4
REUP_WORKER_TTS_AUDIO_TOKENIZER_ID=eustlb/higgs-audio-v2-tokenizer
REUP_WORKER_TTS_AUDIO_TOKENIZER_REVISION=528e871c2a26c4f0f7773b9754e2e1acae20899d
REUP_WORKER_TTS_MODEL_CACHE_ROOT=.state/models
REUP_WORKER_TTS_MODEL_LICENSE=CC_BY_NC
REUP_WORKER_TTS_USAGE_MODE=prototype
REUP_WORKER_TTS_PROMPT_CACHE_ROOT=.state/voice-prompts
REUP_WORKER_TTS_REQUEST_TIMEOUT_SECONDS=300
REUP_WORKER_TTS_MAX_REQUESTS_BEFORE_RESTART=100
REUP_WORKER_TTS_MAX_VRAM_MB_BEFORE_RESTART=10500
