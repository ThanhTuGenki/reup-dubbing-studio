generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentAgentProvider {
  ANTHROPIC
  OPENAI
}

enum StorageBackend {
  R2
}

enum SystemCredentialKind {
  CONTENT_AGENT_API_KEY
  OBJECT_STORAGE_KEYPAIR
}

enum ProfileStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum VoiceMode {
  SINGLE
  DUAL
  MULTI_AUTO
}

enum TimingPolicy {
  PRESERVE_SEGMENT
  FIT_SEGMENT
  ALLOW_DRIFT
}

enum PublishingPlatform {
  YOUTUBE
  FACEBOOK
}

enum VoiceProfileStatus {
  DRAFT
  READY
  BLOCKED_LICENSE
  ARCHIVED
}

enum VoiceLicenseKind {
  OWNED_RECORDING
  AUTHORIZED_COMMERCIAL
  CC_BY
  CC_BY_NC
  CUSTOM
  UNKNOWN
}

enum AssetStorageBackend {
  LOCAL
  R2
  S3
}

enum AssetStatus {
  PENDING
  AVAILABLE
  DELETING
  DELETED
  FAILED
}

enum ChannelProfileAssetRole {
  INTRO
  OUTRO
  LOGO
  WATERMARK
}

enum SeriesProfileAssetRole {
  MASK_REFERENCE_FRAME
}

enum SourcePlatform {
  DOUYIN
  BILIBILI
  YOUTUBE
}

enum CredentialStatus {
  ACTIVE
  EXPIRED
  CAPTCHA_REQUIRED
  INVALID
  REVOKED
}

enum DiscoveryMode {
  JINGXUAN
  CATEGORY
  COURSE
  CREATOR
  MIX
  SEARCH_VIDEO
  SEARCH_USER
  VIDEO_URL
  WATCHLIST
}

enum DiscoveryRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

enum SourceContentType {
  VIDEO
  LONG_VIDEO
  NOTE
  SLIDES
  ARTICLE
  LIVE
  UNKNOWN
}

enum Availability {
  AVAILABLE
  PRIVATE
  REMOVED
  REGION_BLOCKED
  UNKNOWN
}

enum MediaCandidateRole {
  COVER
  COVER_169
  ORIGIN_COVER
  PLAYBACK
  PLAYBACK_H265
  AUDIO
  OTHER
}

enum WatchlistStatus {
  ACTIVE
  PAUSED
  CREDENTIAL_REQUIRED
  FAILED
}

model SystemCredential {
  id               String               @id @db.Uuid
  kind             SystemCredentialKind @unique
  encryptedPayload Bytes                @map("encrypted_payload")
  keyVersion       Int                  @map("key_version")
  hint             String?
  rotatedAt        DateTime             @map("rotated_at") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  contentAgentSettings SystemSetting[] @relation("ContentAgentCredential")
  storageSettings      SystemSetting[] @relation("StorageCredential")

  @@map("system_credentials")
}

model SystemSetting {
  id                       String               @id @db.Uuid
  singletonKey             String               @unique @default("DEFAULT") @map("singleton_key")
  contentAgentProvider     ContentAgentProvider @map("content_agent_provider")
  contentAgentModel        String               @map("content_agent_model")
  contentAgentCredentialId String?              @map("content_agent_credential_id") @db.Uuid
  storageBackend           StorageBackend       @default(R2) @map("storage_backend")
  storageAccountId         String               @map("storage_account_id")
  storageBucket            String               @map("storage_bucket")
  storageCredentialId      String?              @map("storage_credential_id") @db.Uuid
  rawVideoDays             Int                  @default(7) @map("raw_video_days")
  intermediateDays         Int                  @default(3) @map("intermediate_days")
  taskLogDays              Int                  @default(30) @map("task_log_days")
  finalOutputDays          Int                  @default(90) @map("final_output_days")
  version                  Int                  @default(1)
  createdAt                DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  contentAgentCredential SystemCredential? @relation("ContentAgentCredential", fields: [contentAgentCredentialId], references: [id], onDelete: Restrict)
  storageCredential      SystemCredential? @relation("StorageCredential", fields: [storageCredentialId], references: [id], onDelete: Restrict)

  @@map("system_settings")
}

model IdempotencyRecord {
  id           String   @id @db.Uuid
  scope        String
  key          String
  requestHash  String   @map("request_hash")
  responseBody Json     @map("response_body")
  responseEtag String   @map("response_etag")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([scope, key])
  @@map("idempotency_records")
}

model VoiceProfile {
  id                   String             @id @db.Uuid
  name                 String
  normalizedName       String             @unique @map("normalized_name")
  primaryLanguage      String             @map("primary_language")
  description          String?
  tags                 String[]           @default([])
  status               VoiceProfileStatus @default(DRAFT)
  licenseKind          VoiceLicenseKind   @default(UNKNOWN) @map("license_kind")
  licenseReference     String?            @map("license_reference")
  sourceReference      String?            @map("source_reference")
  commercialUseAllowed Boolean            @default(false) @map("commercial_use_allowed")
  version              Int                @default(1)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  channelDefaults ChannelProfile[]     @relation("ChannelDefaultVoice")
  seriesOverrides SeriesProfile[]      @relation("SeriesOverrideVoice")
  samples         VoiceProfileSample[]

  @@index([status, primaryLanguage, createdAt, id])
  @@index([tags], type: Gin)
  @@map("voice_profiles")
}

model VoiceProfileSample {
  id             String   @id @db.Uuid
  voiceProfileId String   @map("voice_profile_id") @db.Uuid
  assetId        String   @map("asset_id") @db.Uuid
  language       String
  transcript     String
  durationMs     Int      @map("duration_ms")
  revision       Int
  isCurrent      Boolean  @default(true) @map("is_current")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  voiceProfile VoiceProfile @relation(fields: [voiceProfileId], references: [id], onDelete: Restrict)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([voiceProfileId, language, revision])
  @@index([voiceProfileId, language, isCurrent])
  @@index([assetId])
  @@map("voice_profile_samples")
}

model ChannelProfile {
  id                      String        @id @db.Uuid
  name                    String
  normalizedName          String        @map("normalized_name")
  status                  ProfileStatus @default(DRAFT)
  targetLanguage          String        @map("target_language")
  defaultVoiceProfileId   String?       @map("default_voice_profile_id") @db.Uuid
  defaultVoiceMode        VoiceMode     @default(SINGLE) @map("default_voice_mode")
  subtitleLanguage        String        @map("subtitle_language")
  subtitleFilenameRule    String        @map("subtitle_filename_rule")
  subtitleMaxLineLength   Int?          @map("subtitle_max_line_length")
  ttsSpeed                Decimal       @default(1) @map("tts_speed") @db.Decimal(5, 3)
  timingPolicy            TimingPolicy  @default(FIT_SEGMENT) @map("timing_policy")
  output16x9Enabled       Boolean       @default(true) @map("output_16x9_enabled")
  output9x16Enabled       Boolean       @default(false) @map("output_9x16_enabled")
  contentVoiceRules       Json          @default("{}") @map("content_voice_rules")
  contentCtaTemplate      String?       @map("content_cta_template")
  contentMetadataTemplate Json          @default("{}") @map("content_metadata_template")
  contentBaseKeywords     String[]      @default([]) @map("content_base_keywords")
  version                 Int           @default(1)
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  defaultVoice VoiceProfile?           @relation("ChannelDefaultVoice", fields: [defaultVoiceProfileId], references: [id], onDelete: Restrict)
  destinations PublishingDestination[]
  series       SeriesProfile[]
  assets       ChannelProfileAsset[]

  @@index([status, createdAt, id])
  @@map("channel_profiles")
}

model PublishingDestination {
  id               String             @id @db.Uuid
  channelProfileId String             @map("channel_profile_id") @db.Uuid
  platform         PublishingPlatform
  externalId       String?            @map("external_id")
  displayName      String             @map("display_name")
  normalizedName   String             @map("normalized_name")
  isRequired       Boolean            @default(false) @map("is_required")
  isActive         Boolean            @default(true) @map("is_active")
  platformConfig   Json               @default("{}") @map("platform_config")
  version          Int                @default(1)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  channelProfile ChannelProfile @relation(fields: [channelProfileId], references: [id], onDelete: Restrict)

  @@index([channelProfileId])
  @@map("publishing_destinations")
}

model SeriesProfile {
  id                            String        @id @db.Uuid
  channelProfileId              String        @map("channel_profile_id") @db.Uuid
  name                          String
  normalizedName                String        @map("normalized_name")
  status                        ProfileStatus @default(DRAFT)
  targetLanguageOverride        String?       @map("target_language_override")
  defaultVoiceProfileOverrideId String?       @map("default_voice_profile_override_id") @db.Uuid
  voiceModeOverride             VoiceMode?    @map("voice_mode_override")
  subtitleLanguageOverride      String?       @map("subtitle_language_override")
  subtitleFilenameRuleOverride  String?       @map("subtitle_filename_rule_override")
  subtitleMaxLineLengthOverride Int?          @map("subtitle_max_line_length_override")
  ttsSpeedOverride              Decimal?      @map("tts_speed_override") @db.Decimal(5, 3)
  timingPolicyOverride          TimingPolicy? @map("timing_policy_override")
  output16x9Override            Boolean?      @map("output_16x9_override")
  output9x16Override            Boolean?      @map("output_9x16_override")
  maskX                         Decimal?      @map("mask_x") @db.Decimal(9, 8)
  maskY                         Decimal?      @map("mask_y") @db.Decimal(9, 8)
  maskWidth                     Decimal?      @map("mask_width") @db.Decimal(9, 8)
  maskHeight                    Decimal?      @map("mask_height") @db.Decimal(9, 8)
  version                       Int           @default(1)
  createdAt                     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  channelProfile       ChannelProfile       @relation(fields: [channelProfileId], references: [id], onDelete: Restrict)
  defaultVoiceOverride VoiceProfile?        @relation("SeriesOverrideVoice", fields: [defaultVoiceProfileOverrideId], references: [id], onDelete: Restrict)
  assets               SeriesProfileAsset[]

  @@index([channelProfileId, status, createdAt, id])
  @@map("series_profiles")
}

model Asset {
  id             String              @id @db.Uuid
  storageBackend AssetStorageBackend @map("storage_backend")
  bucket         String?
  objectKey      String              @map("object_key")
  fileName       String              @map("file_name")
  status         AssetStatus         @default(PENDING)
  checksumSha256 String?             @map("checksum_sha256")
  byteSize       BigInt?             @map("byte_size")
  contentType    String?             @map("content_type")
  width          Int?
  height         Int?
  uploadedAt     DateTime?           @map("uploaded_at") @db.Timestamptz(6)
  verifiedAt     DateTime?           @map("verified_at") @db.Timestamptz(6)
  metadata       Json                @default("{}")
  version        Int                 @default(1)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  channelLinks ChannelProfileAsset[]
  seriesLinks  SeriesProfileAsset[]
  voiceSamples VoiceProfileSample[]

  @@unique([storageBackend, bucket, objectKey])
  @@index([status, createdAt])
  @@map("assets")
}

model ChannelProfileAsset {
  id               String                  @id @db.Uuid
  channelProfileId String                  @map("channel_profile_id") @db.Uuid
  assetId          String                  @map("asset_id") @db.Uuid
  role             ChannelProfileAssetRole
  revision         Int
  isCurrent        Boolean                 @default(true) @map("is_current")
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  channelProfile ChannelProfile @relation(fields: [channelProfileId], references: [id], onDelete: Restrict)
  asset          Asset          @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([channelProfileId, role, revision])
  @@index([assetId])
  @@map("channel_profile_assets")
}

model SeriesProfileAsset {
  id              String                 @id @db.Uuid
  seriesProfileId String                 @map("series_profile_id") @db.Uuid
  assetId         String                 @map("asset_id") @db.Uuid
  role            SeriesProfileAssetRole
  revision        Int
  isCurrent       Boolean                @default(true) @map("is_current")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  seriesProfile SeriesProfile @relation(fields: [seriesProfileId], references: [id], onDelete: Restrict)
  asset         Asset         @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([seriesProfileId, role, revision])
  @@index([assetId])
  @@map("series_profile_assets")
}

model SourceAccount {
  id                  String           @id @db.Uuid
  platform            SourcePlatform
  displayName         String           @map("display_name")
  status              CredentialStatus @default(INVALID)
  lastValidatedAt     DateTime?        @map("last_validated_at") @db.Timestamptz(6)
  lastSuccessAt       DateTime?        @map("last_success_at") @db.Timestamptz(6)
  consecutiveFailures Int              @default(0) @map("consecutive_failures")
  cooldownUntil       DateTime?        @map("cooldown_until") @db.Timestamptz(6)
  version             Int              @default(1)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  credentials SourceCredential[]
  runs        DiscoveryRun[]
  watchlists  Watchlist[]

  @@index([platform, createdAt, id])
  @@map("source_accounts")
}

model SourceCredential {
  id              String    @id @db.Uuid
  sourceAccountId String    @map("source_account_id") @db.Uuid
  kind            String
  ciphertext      Bytes
  encryptionKeyId String    @map("encryption_key_id")
  encryptedAt     DateTime  @map("encrypted_at") @db.Timestamptz(6)
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  sourceAccount SourceAccount @relation(fields: [sourceAccountId], references: [id], onDelete: Restrict)

  @@index([sourceAccountId, kind, revokedAt])
  @@map("source_credentials")
}

model SourceCreator {
  id               String         @id @db.Uuid
  platform         SourcePlatform
  externalId       String         @map("external_id")
  externalSecureId String?        @map("external_secure_id")
  nickname         String?
  avatarUrl        String?        @map("avatar_url")
  profileUrl       String?        @map("profile_url")
  availability     Availability   @default(UNKNOWN)
  firstSeenAt      DateTime       @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt       DateTime       @map("last_seen_at") @db.Timestamptz(6)
  metadata         Json           @default("{}")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  contents SourceContent[]

  @@unique([platform, externalId])
  @@index([platform, lastSeenAt])
  @@map("source_creators")
}

model SourceCategory {
  id          String         @id @db.Uuid
  platform    SourcePlatform
  externalKey String         @map("external_key")
  slug        String?
  label       String
  kind        String
  parentId    String?        @map("parent_id") @db.Uuid
  isActive    Boolean        @default(true) @map("is_active")
  lastSeenAt  DateTime       @map("last_seen_at") @db.Timestamptz(6)
  metadata    Json           @default("{}")

  parent       SourceCategory?         @relation("SourceCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     SourceCategory[]        @relation("SourceCategoryTree")
  contentLinks SourceContentCategory[]
  runItems     DiscoveryItem[]
  runs         DiscoveryRun[]

  @@unique([platform, kind, externalKey])
  @@index([platform, kind, isActive])
  @@map("source_categories")
}

model SourceContent {
  id                String            @id @db.Uuid
  platform          SourcePlatform
  externalId        String            @map("external_id")
  encodedExternalId String?           @map("encoded_external_id")
  creatorId         String?           @map("creator_id") @db.Uuid
  contentType       SourceContentType @map("content_type")
  externalTypeCode  String?           @map("external_type_code")
  title             String?
  description       String?
  canonicalUrl      String?           @map("canonical_url")
  publishedAt       DateTime?         @map("published_at") @db.Timestamptz(6)
  durationMs        Int?              @map("duration_ms")
  width             Int?
  height            Int?
  availability      Availability      @default(UNKNOWN)
  isIngestEligible  Boolean           @default(false) @map("is_ingest_eligible")
  firstSeenAt       DateTime          @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt        DateTime          @map("last_seen_at") @db.Timestamptz(6)
  metadataVersion   Int               @default(1) @map("metadata_version")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator         SourceCreator?          @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  mediaCandidates SourceMediaCandidate[]
  metricSnapshots ContentMetricSnapshot[]
  categoryLinks   SourceContentCategory[]
  discoveryItems  DiscoveryItem[]

  @@unique([platform, externalId])
  @@index([platform, publishedAt, id])
  @@index([creatorId, publishedAt, id])
  @@index([availability, lastSeenAt])
  @@index([contentType, publishedAt])
  @@map("source_contents")
}

model SourceMediaCandidate {
  id              String             @id @db.Uuid
  sourceContentId String             @map("source_content_id") @db.Uuid
  role            MediaCandidateRole
  canonicalUrl    String?            @map("canonical_url")
  urlFingerprint  String             @map("url_fingerprint")
  requiresRefresh Boolean            @default(false) @map("requires_refresh")
  codec           String?
  container       String?
  bitrate         Int?
  width           Int?
  height          Int?
  observedAt      DateTime           @map("observed_at") @db.Timestamptz(6)
  expiresAt       DateTime?          @map("expires_at") @db.Timestamptz(6)
  metadata        Json               @default("{}")

  sourceContent SourceContent @relation(fields: [sourceContentId], references: [id], onDelete: Restrict)

  @@unique([sourceContentId, role, urlFingerprint])
  @@index([sourceContentId, role, observedAt])
  @@map("source_media_candidates")
}

model ContentMetricSnapshot {
  id              String   @id @db.Uuid
  sourceContentId String   @map("source_content_id") @db.Uuid
  capturedAt      DateTime @map("captured_at") @db.Timestamptz(6)
  playCount       BigInt?  @map("play_count")
  diggCount       BigInt?  @map("digg_count")
  commentCount    BigInt?  @map("comment_count")
  collectCount    BigInt?  @map("collect_count")
  shareCount      BigInt?  @map("share_count")
  forwardCount    BigInt?  @map("forward_count")
  liveWatchCount  BigInt?  @map("live_watch_count")

  sourceContent SourceContent @relation(fields: [sourceContentId], references: [id], onDelete: Restrict)

  @@unique([sourceContentId, capturedAt])
  @@map("content_metric_snapshots")
}

model SourceContentCategory {
  sourceContentId  String @map("source_content_id") @db.Uuid
  sourceCategoryId String @map("source_category_id") @db.Uuid
  relationType     String @map("relation_type")

  sourceContent  SourceContent  @relation(fields: [sourceContentId], references: [id], onDelete: Restrict)
  sourceCategory SourceCategory @relation(fields: [sourceCategoryId], references: [id], onDelete: Restrict)

  @@id([sourceContentId, sourceCategoryId, relationType])
  @@map("source_content_categories")
}

model DiscoveryRun {
  id              String             @id @db.Uuid
  sourceAccountId String             @map("source_account_id") @db.Uuid
  mode            DiscoveryMode
  status          DiscoveryRunStatus @default(QUEUED)
  input           String?
  query           String?
  categoryId      String?            @map("category_id") @db.Uuid
  watchlistId     String?            @map("watchlist_id") @db.Uuid
  providerCursor  Json?              @map("provider_cursor")
  requestedLimit  Int?               @map("requested_limit")
  pageCount       Int                @default(0) @map("page_count")
  itemCount       Int                @default(0) @map("item_count")
  skippedCounts   Json               @default("{}") @map("skipped_counts")
  responseLogId   String?            @map("response_log_id")
  errorCode       String?            @map("error_code")
  errorDetailSafe String?            @map("error_detail_safe")
  version         Int                @default(1)
  startedAt       DateTime?          @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime?          @map("finished_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceAccount SourceAccount    @relation(fields: [sourceAccountId], references: [id], onDelete: Restrict)
  category      SourceCategory?  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  watchlist     Watchlist?       @relation(fields: [watchlistId], references: [id], onDelete: Restrict)
  items         DiscoveryItem[]
  rawEvents     SourceRawEvent[]

  @@index([sourceAccountId, status, createdAt])
  @@index([watchlistId, status, createdAt])
  @@map("discovery_runs")
}

model DiscoveryItem {
  id              String   @id @db.Uuid
  discoveryRunId  String   @map("discovery_run_id") @db.Uuid
  sourceContentId String   @map("source_content_id") @db.Uuid
  rank            Int
  pageIndex       Int      @map("page_index")
  categoryId      String?  @map("category_id") @db.Uuid
  isTopCard       Boolean  @default(false) @map("is_top_card")
  isBigCard       Boolean  @default(false) @map("is_big_card")
  providerReason  String?  @map("provider_reason")
  discoveredAt    DateTime @map("discovered_at") @db.Timestamptz(6)

  discoveryRun  DiscoveryRun    @relation(fields: [discoveryRunId], references: [id], onDelete: Restrict)
  sourceContent SourceContent   @relation(fields: [sourceContentId], references: [id], onDelete: Restrict)
  category      SourceCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([discoveryRunId, sourceContentId])
  @@unique([discoveryRunId, rank])
  @@index([discoveryRunId, rank, id])
  @@map("discovery_items")
}

model Watchlist {
  id                  String          @id @db.Uuid
  sourceAccountId     String          @map("source_account_id") @db.Uuid
  mode                DiscoveryMode
  resolvedInput       Json            @map("resolved_input")
  resolvedIdentity    String          @map("resolved_identity")
  displayName         String          @map("display_name")
  status              WatchlistStatus @default(ACTIVE)
  scheduleIntervalMin Int             @map("schedule_interval_min")
  nextRunAt           DateTime        @map("next_run_at") @db.Timestamptz(6)
  lastRunAt           DateTime?       @map("last_run_at") @db.Timestamptz(6)
  lastSuccessAt       DateTime?       @map("last_success_at") @db.Timestamptz(6)
  cursor              Json?
  consecutiveFailures Int             @default(0) @map("consecutive_failures")
  version             Int             @default(1)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceAccount SourceAccount  @relation(fields: [sourceAccountId], references: [id], onDelete: Restrict)
  runs          DiscoveryRun[]

  @@unique([sourceAccountId, mode, resolvedIdentity])
  @@index([status, nextRunAt])
  @@map("watchlists")
}

model SourceRawEvent {
  id              String   @id @db.Uuid
  discoveryRunId  String   @map("discovery_run_id") @db.Uuid
  endpointKind    String   @map("endpoint_kind")
  schemaVersion   Int      @map("schema_version")
  payloadChecksum String   @map("payload_checksum")
  payload         Json
  capturedAt      DateTime @map("captured_at") @db.Timestamptz(6)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(6)

  discoveryRun DiscoveryRun @relation(fields: [discoveryRunId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@map("source_raw_events")
}
