  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  worker   Worker          @relation(fields: [workerId], references: [id], onDelete: Restrict)
  sessions WorkerSession[]

  @@index([credentialPrefix])
  @@map("worker_credentials")
}

model WorkerBillingSession {
  id                     String    @id @db.Uuid
  workerId               String    @map("worker_id") @db.Uuid
  provider               String
  providerInstanceId     String?   @map("provider_instance_id")
  hourlyRateCp           Decimal   @map("hourly_rate_cp") @db.Decimal(20, 6)
  paidVndPerCp           Decimal?  @map("paid_vnd_per_cp") @db.Decimal(20, 8)
  billingStartedAt       DateTime  @map("billing_started_at") @db.Timestamptz(6)
  billingEndedAt         DateTime? @map("billing_ended_at") @db.Timestamptz(6)
  terminationConfirmedAt DateTime? @map("termination_confirmed_at") @db.Timestamptz(6)
  estimatedCostCp        Decimal?  @map("estimated_cost_cp") @db.Decimal(24, 6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  worker   Worker          @relation(fields: [workerId], references: [id], onDelete: Restrict)
  sessions WorkerSession[]

  @@map("worker_billing_sessions")
}

model WorkerSession {
  id                    String                  @id @db.Uuid
  workerId              String                  @map("worker_id") @db.Uuid
  credentialId          String                  @map("credential_id") @db.Uuid
  billingSessionId      String                  @map("billing_session_id") @db.Uuid
  sessionNonce          String                  @map("session_nonce") @db.Uuid
  imageId               String                  @map("image_id") @db.Uuid
  imageDigest           String                  @map("image_digest")
  agentVersion          String                  @map("agent_version")
  contractVersion       Int                     @map("contract_version")
  capabilities          String[]                @default([])
  gpuInventory          Json                    @default("[]") @map("gpu_inventory")
  cpuInventory          Json                    @default("{}") @map("cpu_inventory")
  capacity              Json                    @default("{}")
  telemetrySafe         Json                    @default("{}") @map("telemetry_safe")
  currentTaskCount      Int                     @default(0) @map("current_task_count")
  lastHeartbeatSequence BigInt                  @default(0) @map("last_heartbeat_sequence")
  startedAt             DateTime                @default(now()) @map("started_at") @db.Timestamptz(6)
  lastHeartbeatAt       DateTime                @default(now()) @map("last_heartbeat_at") @db.Timestamptz(6)
  drainingAt            DateTime?               @map("draining_at") @db.Timestamptz(6)
  endedAt               DateTime?               @map("ended_at") @db.Timestamptz(6)
  endReason             WorkerSessionEndReason? @map("end_reason")

  worker         Worker               @relation(fields: [workerId], references: [id], onDelete: Restrict)
  credential     WorkerCredential     @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  billingSession WorkerBillingSession @relation(fields: [billingSessionId], references: [id], onDelete: Restrict)
  image          ApprovedWorkerImage  @relation(fields: [imageId], references: [id], onDelete: Restrict)
  taskAttempts   TaskAttempt[]
  taskLeases     TaskLease[]

  @@unique([workerId, sessionNonce])
  @@index([lastHeartbeatAt])
  @@map("worker_sessions")
}

model TaskAttempt {
  id                 String            @id @db.Uuid
  pipelineTaskId     String            @map("pipeline_task_id") @db.Uuid
  attemptNumber      Int               @map("attempt_number")
  executorKind       TaskExecutorKind  @map("executor_kind")
  executorInstanceId String            @map("executor_instance_id")
  workerSessionId    String?           @map("worker_session_id") @db.Uuid
  status             TaskAttemptStatus
  startedAt          DateTime          @map("started_at") @db.Timestamptz(6)
  finishedAt         DateTime?         @map("finished_at") @db.Timestamptz(6)
  queueWaitMs        BigInt?           @map("queue_wait_ms")
  downloadMs         BigInt?           @map("download_ms")
  modelLoadMs        BigInt?           @map("model_load_ms")
  executionMs        BigInt?           @map("execution_ms")
  uploadMs           BigInt?           @map("upload_ms")
  gpuActiveMs        BigInt?           @map("gpu_active_ms")
  peakVramMb         Int?              @map("peak_vram_mb")
  inputBytes         BigInt?           @map("input_bytes")
  outputBytes        BigInt?           @map("output_bytes")
  exitCode           Int?              @map("exit_code")
  errorCode          String?           @map("error_code")
  errorDetailSafe    String?           @map("error_detail_safe")
  metricsSafe        Json              @default("{}") @map("metrics_safe")

  pipelineTask          PipelineTask           @relation(fields: [pipelineTaskId], references: [id], onDelete: Restrict)
  workerSession         WorkerSession?         @relation(fields: [workerSessionId], references: [id], onDelete: Restrict)
  leases                TaskLease[]
  workflowEvents        WorkflowEvent[]
  createdAssets         Asset[]
  transcriptRuns        TranscriptRun[]
  segmentAudioRevisions SegmentAudioRevision[]

  @@unique([pipelineTaskId, attemptNumber])
  @@index([pipelineTaskId, startedAt])
  @@map("task_attempts")
}

model TaskLease {
  id                 String           @id @db.Uuid
  pipelineTaskId     String           @map("pipeline_task_id") @db.Uuid
  taskAttemptId      String           @map("task_attempt_id") @db.Uuid
  executorKind       TaskExecutorKind @map("executor_kind")
  executorInstanceId String           @map("executor_instance_id")
  workerSessionId    String?          @map("worker_session_id") @db.Uuid
  fencingToken       BigInt           @map("fencing_token")
  leasedAt           DateTime         @map("leased_at") @db.Timestamptz(6)
  renewedAt          DateTime         @map("renewed_at") @db.Timestamptz(6)
  expiresAt          DateTime         @map("expires_at") @db.Timestamptz(6)
  releasedAt         DateTime?        @map("released_at") @db.Timestamptz(6)
  releaseReason      String?          @map("release_reason")

  pipelineTask  PipelineTask   @relation(fields: [pipelineTaskId], references: [id], onDelete: Restrict)
  taskAttempt   TaskAttempt    @relation(fields: [taskAttemptId], references: [id], onDelete: Restrict)
  workerSession WorkerSession? @relation(fields: [workerSessionId], references: [id], onDelete: Restrict)

  @@unique([pipelineTaskId, fencingToken])
  @@index([expiresAt])
  @@map("task_leases")
}

model WorkflowEvent {
  id             String         @id @db.Uuid
  videoId        String?        @map("video_id") @db.Uuid
  pipelineJobId  String?        @map("pipeline_job_id") @db.Uuid
  pipelineTaskId String?        @map("pipeline_task_id") @db.Uuid
  taskAttemptId  String?        @map("task_attempt_id") @db.Uuid
  eventType      String         @map("event_type")
  fromStatus     String?        @map("from_status")
  toStatus       String?        @map("to_status")
  actorType      AuditActorType @map("actor_type")
  actorId        String?        @map("actor_id") @db.Uuid
  messageSafe    String?        @map("message_safe")
  payloadSafe    Json           @default("{}") @map("payload_safe")
  occurredAt     DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)

  video        Video?        @relation(fields: [videoId], references: [id], onDelete: Restrict)
  pipelineJob  PipelineJob?  @relation(fields: [pipelineJobId], references: [id], onDelete: Restrict)
  pipelineTask PipelineTask? @relation(fields: [pipelineTaskId], references: [id], onDelete: Restrict)
  taskAttempt  TaskAttempt?  @relation(fields: [taskAttemptId], references: [id], onDelete: Restrict)

  @@index([pipelineJobId, occurredAt, id])
  @@map("workflow_events")
}

model OutboxMessage {
  id            String    @id @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type")
  payloadSafe   Json      @map("payload_safe")
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  attemptCount  Int       @default(0) @map("attempt_count")
  lockedBy      String?   @map("locked_by")
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  lastErrorSafe String?   @map("last_error_safe")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([publishedAt, availableAt, id])
  @@index([lockedUntil])
  @@map("outbox_messages")
}

model AuditEvent {
  id           String         @id @db.Uuid
  actorType    AuditActorType @map("actor_type")
  actorId      String?        @map("actor_id") @db.Uuid
  action       String
  entityType   String         @map("entity_type")
  entityId     String?        @map("entity_id") @db.Uuid
  requestId    String?        @map("request_id") @db.Uuid
  beforeSafe   Json?          @map("before_safe")
  afterSafe    Json?          @map("after_safe")
  metadataSafe Json           @default("{}") @map("metadata_safe")
  occurredAt   DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([entityType, entityId, occurredAt])
  @@index([occurredAt])
  @@map("audit_events")
}

model SourceMediaCandidate {
  id              String             @id @db.Uuid
  sourceContentId String             @map("source_content_id") @db.Uuid
  role            MediaCandidateRole
  canonicalUrl    String?            @map("canonical_url")
  urlFingerprint  String             @map("url_fingerprint")
  requiresRefresh Boolean            @default(false) @map("requires_refresh")
  codec           String?
  container       String?
  bitrate         Int?
  width           Int?
  height          Int?
  observedAt      DateTime           @map("observed_at") @db.Timestamptz(6)
  expiresAt       DateTime?          @map("expires_at") @db.Timestamptz(6)
  metadata        Json               @default("{}")

  sourceContent SourceContent @relation(fields: [sourceContentId], references: [id], onDelete: Restrict)

  @@unique([sourceContentId, role, urlFingerprint])
  @@index([sourceContentId, role, observedAt])
  @@map("source_media_candidates")
}

model ContentMetricSnapshot {
  id              String   @id @db.Uuid
  sourceContentId String   @map("source_content_id") @db.Uuid
  capturedAt      DateTime @map("captured_at") @db.Timestamptz(6)
  playCount       BigInt?  @map("play_count")
  diggCount       BigInt?  @map("digg_count")
  commentCount    BigInt?  @map("comment_count")
  collectCount    BigInt?  @map("collect_count")
  shareCount      BigInt?  @map("share_count")
  forwardCount    BigInt?  @map("forward_count")
  liveWatchCount  BigInt?  @map("live_watch_count")

  sourceContent SourceContent @relation(fields: [sourceContentId], references: [id], onDelete: Restrict)

  @@unique([sourceContentId, capturedAt])
  @@map("content_metric_snapshots")
}

model SourceContentCategory {
  sourceContentId  String @map("source_content_id") @db.Uuid
  sourceCategoryId String @map("source_category_id") @db.Uuid
  relationType     String @map("relation_type")

  sourceContent  SourceContent  @relation(fields: [sourceContentId], references: [id], onDelete: Restrict)
  sourceCategory SourceCategory @relation(fields: [sourceCategoryId], references: [id], onDelete: Restrict)

  @@id([sourceContentId, sourceCategoryId, relationType])
  @@map("source_content_categories")
}

model DiscoveryRun {
  id              String             @id @db.Uuid
  sourceAccountId String             @map("source_account_id") @db.Uuid
  mode            DiscoveryMode
  status          DiscoveryRunStatus @default(QUEUED)
  input           String?
  query           String?
  categoryId      String?            @map("category_id") @db.Uuid
  watchlistId     String?            @map("watchlist_id") @db.Uuid
  providerCursor  Json?              @map("provider_cursor")
  requestedLimit  Int?               @map("requested_limit")
  pageCount       Int                @default(0) @map("page_count")
  itemCount       Int                @default(0) @map("item_count")
  skippedCounts   Json               @default("{}") @map("skipped_counts")
  responseLogId   String?            @map("response_log_id")
  errorCode       String?            @map("error_code")
  errorDetailSafe String?            @map("error_detail_safe")
  version         Int                @default(1)
  startedAt       DateTime?          @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime?          @map("finished_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceAccount SourceAccount    @relation(fields: [sourceAccountId], references: [id], onDelete: Restrict)
  category      SourceCategory?  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  watchlist     Watchlist?       @relation(fields: [watchlistId], references: [id], onDelete: Restrict)
  items         DiscoveryItem[]
  rawEvents     SourceRawEvent[]

  @@index([sourceAccountId, status, createdAt])
  @@index([watchlistId, status, createdAt])
  @@map("discovery_runs")
}

model DiscoveryItem {
  id              String   @id @db.Uuid
  discoveryRunId  String   @map("discovery_run_id") @db.Uuid
  sourceContentId String   @map("source_content_id") @db.Uuid
  rank            Int
  pageIndex       Int      @map("page_index")
  categoryId      String?  @map("category_id") @db.Uuid
  isTopCard       Boolean  @default(false) @map("is_top_card")
  isBigCard       Boolean  @default(false) @map("is_big_card")
  providerReason  String?  @map("provider_reason")
  discoveredAt    DateTime @map("discovered_at") @db.Timestamptz(6)

  discoveryRun  DiscoveryRun    @relation(fields: [discoveryRunId], references: [id], onDelete: Restrict)
  sourceContent SourceContent   @relation(fields: [sourceContentId], references: [id], onDelete: Restrict)
  category      SourceCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([discoveryRunId, sourceContentId])
  @@unique([discoveryRunId, rank])
  @@index([discoveryRunId, rank, id])
  @@map("discovery_items")
}

model Watchlist {
  id                  String          @id @db.Uuid
  sourceAccountId     String          @map("source_account_id") @db.Uuid
  mode                DiscoveryMode
  resolvedInput       Json            @map("resolved_input")
  resolvedIdentity    String          @map("resolved_identity")
  displayName         String          @map("display_name")
  status              WatchlistStatus @default(ACTIVE)
  scheduleIntervalMin Int             @map("schedule_interval_min")
  nextRunAt           DateTime        @map("next_run_at") @db.Timestamptz(6)
  lastRunAt           DateTime?       @map("last_run_at") @db.Timestamptz(6)
  lastSuccessAt       DateTime?       @map("last_success_at") @db.Timestamptz(6)
  cursor              Json?
  consecutiveFailures Int             @default(0) @map("consecutive_failures")
  version             Int             @default(1)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceAccount SourceAccount  @relation(fields: [sourceAccountId], references: [id], onDelete: Restrict)
  runs          DiscoveryRun[]

  @@unique([sourceAccountId, mode, resolvedIdentity])
  @@index([status, nextRunAt])
  @@map("watchlists")
}

model SourceRawEvent {
  id              String   @id @db.Uuid
  discoveryRunId  String   @map("discovery_run_id") @db.Uuid
  endpointKind    String   @map("endpoint_kind")
  schemaVersion   Int      @map("schema_version")
  payloadChecksum String   @map("payload_checksum")
  payload         Json
  capturedAt      DateTime @map("captured_at") @db.Timestamptz(6)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(6)

  discoveryRun DiscoveryRun @relation(fields: [discoveryRunId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@map("source_raw_events")
}
