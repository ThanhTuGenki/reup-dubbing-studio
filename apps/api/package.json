{
  "name": "@reup-dubbing-studio/api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "if find src test -type f -name '*.ts' -print -quit 2>/dev/null | grep -q .; then tsc --noEmit; fi",
    "test": "jest --config ./jest.config.cjs --runInBand --testMatch '**/*.spec.ts' --testPathIgnorePatterns '/\\.e2e-spec\\.ts$/'",
    "test:e2e": "node -e \"process.argv = ['node', 'jest', '--config', './jest.config.cjs', '--runInBand', '--testMatch', '**/*.e2e-spec.ts', ...process.argv.slice(1).filter((arg) => arg !== '--')]; require(require.resolve('jest').replace('/build/index.js', '/bin/jest.js'));\" --"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "fastify": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@reup-dubbing-studio/eslint-config": "workspace:*",
    "@reup-dubbing-studio/tsconfig": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
